RewriteEngine On

# Rota para Aulas Gratuitas (Biblioteca Principal)
RewriteRule ^aulas-gratuitas/?$ aulas-gratuitas.php [L,QSA]

# Rota para Aulas Gratuitas por Banca (Deve vir antes do canal para evitar colisão)
RewriteRule ^aulas-gratuitas/banca/([a-z0-9\-]+)/?$ banca-redirect.php?slug=$1 [L,QSA]

# Rota para Canais de Aulas Gratuitas
RewriteRule ^aulas-gratuitas/([a-z0-9\-]+)/?$ canal-redirect.php?slug=$1 [L,QSA]

# Rota para Videoaula Individual dentro de um Canal
RewriteRule ^aulas-gratuitas/([a-z0-9\-]+)/([a-z0-9\-]+)/?$ aula-redirect.php?canal=$1&video=$2 [L,QSA]

# Rota para artigos do blog com slug
RewriteRule ^blog/([a-z0-9\-]+)/?$ post-redirect.php?slug=$1 [L,QSA]

# Rota para cursos com slug
RewriteRule ^curso/([a-z0-9\-]+)/?$ curso-redirect.php?slug=$1 [L,QSA]

# Rota para apostilas com slug
RewriteRule ^apostila/([a-z0-9\-]+)/?$ apostila-redirect.php?slug=$1 [L,QSA]

# Rota para eventos com slug
RewriteRule ^evento/([a-z0-9\-]+)/?$ evento-redirect.php?slug=$1 [L,QSA]

<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>
